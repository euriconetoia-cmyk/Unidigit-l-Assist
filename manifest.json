{
  "manifest_version": 3,
  "name": "Unidigit@l Assist",
  "version": "0.18.1",
  "key": "",
  "description": "Ferramentas do tutor EaD para o Moodle (correção, pendências, alunos e relatórios) — botão lateral. Nada roda sozinho.",
  "minimum_chrome_version": "108",
  "permissions": [
    "scripting",
    "storage",
    "downloads"
  ],
  "host_permissions": [
    "https://ead.senai.br/*",
    "https://ead.fieg.com.br/*"
  ],
  "optional_host_permissions": [
    "https://create.kahoot.it/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://ead.senai.br/*",
        "https://ead.fieg.com.br/*"
      ],
      "js": [
        "launcher.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Ferramentas EaD",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}