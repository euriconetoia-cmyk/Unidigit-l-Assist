{
  "name": "unidigital-assist",
  "version": "0.18.1",
  "private": true,
  "type": "module",
  "description": "Unidigit@l Assist — ferramentas do tutor EaD para o Moodle (extensão do Chrome): correção, pendências, alunos, acompanhamento e relatórios.",
  "author": "Eurico Cirilo",
  "contributors": [
    "Julio Alves"
  ],
  "license": "MIT",
  "homepage": "https://github.com/euriconetoia-cmyk/Unidigit-l-Assist#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/euriconetoia-cmyk/Unidigit-l-Assist.git"
  },
  "bugs": {
    "url": "https://github.com/euriconetoia-cmyk/Unidigit-l-Assist/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "moodle",
    "chrome-extension",
    "ead",
    "senai",
    "tutoria"
  ],
  "scripts": {
    "sync": "node scripts/sync-importar-notas.mjs && node scripts/sync-assistente.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.js",
    "validate": "node scripts/validate.mjs",
    "package": "node scripts/package.mjs",
    "test:e2e": "node tests/e2e/lateral.mjs",
    "build:blocos": "node scripts/build.mjs --with-blocos",
    "test:e2e:datas": "node tests/e2e/datas.mjs",
    "test:e2e:cronograma": "node tests/e2e/cronograma.mjs",
    "test:e2e:blocos": "node tests/e2e/blocos.mjs",
    "test:e2e:criar": "node tests/e2e/criar.mjs"
  },
  "devDependencies": {
    "blockly": "^13.4.0",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1"
  }
}
